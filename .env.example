# Copy to .env for local development. Production values live in the server's environment.
DATABASE_URL=postgres://anytogether:anytogether@127.0.0.1:54329/anytogether
VALKEY_URL=redis://127.0.0.1:63799
# Ed25519 private key (PKCS#8 PEM) for access tokens; generated per run when empty (development).
JWT_PRIVATE_KEY=
PUBLIC_URL=http://localhost:3000
# Earlier PUBLIC_URLs after a domain move (comma list): tokens signed under them still verify
# in the API and realtime. Signing always uses PUBLIC_URL.
PREVIOUS_PUBLIC_URLS=
# The site's name in passkey prompts (passkeys belong to PUBLIC_URL's host name). Default AnyTogether.
WEBAUTHN_RP_NAME=
# Sign-in providers (empty disables one).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Discord also links accounts to profiles. Register both redirect URIs in the Discord application:
# <PUBLIC_URL>/auth/discord/callback (sign-in) and <PUBLIC_URL>/connections/discord/callback (linking).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: a Steam Web API key, for the persona name of a linked Steam account (linking itself
# needs no key; without one the public Steam profile is read).
STEAM_WEB_API_KEY=
# Mail for sign-in codes: "log" prints them (development), or "resend" with RESEND_API_KEY.
MAIL_TRANSPORT=log
RESEND_API_KEY=
MAIL_FROM=AnyTogether <signin@kodla.agency>
# Calls: the TURN REST secret shared with the relay (coturn static-auth-secret), and the STUN/TURN
# URLs handed to clients, comma separated, e.g. stun:relay.example:3478,turn:relay.example:3478,
# turns:relay.example:5349?transport=tcp. Empty: calls get no ICE servers from us.
TURN_SECRET=
TURN_URLS=
# Optional media server (LiveKit) for share plays above four viewers and party calls above eight
# voices; without it those are refused and everything else stays peer to peer. LIVEKIT_URL is
# what clients connect to (wss://<domain>/livekit behind deploy/'s Caddy), LIVEKIT_API_URL where
# the API reaches LiveKit's server API (empty: LIVEKIT_URL with https), and a key and secret
# (the secret at least 32 characters). SFU_MAX_SHARE_VIEWERS (16, up to 50) and SFU_MAX_PARTY_SIZE
# (24, up to 32) cap them. Locally: docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp
# livekit/livekit-server:v1.13.10 --dev (key devkey, secret secret) and LIVEKIT_URL=ws://localhost:7880.
# LIVEKIT_URL=
# LIVEKIT_API_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SFU_MAX_SHARE_VIEWERS=16
# SFU_MAX_PARTY_SIZE=24
# Domains messages may not link to, comma separated. Unset: a built-in list of IP loggers; empty: none.
# BLOCKED_LINK_DOMAINS=
# Optional: a GitHub token (no scopes needed) so the downloads page's release checks get more than
# GitHub's 60 calls an hour per address. Answers are cached for ten minutes either way.
# GITHUB_TOKEN=
# Retiring old clients: the oldest launcher and phone app versions the API still answers, per
# platform (macos, windows, linux, desktop = windows and linux, phone), e.g.
# macos=0.2.20,desktop=0.1.8,phone=1.16.0. Older ones get "client_too_old" and an update screen.
# Empty: nobody is refused. CLIENT_DOWNLOAD_URL: where they update (default PUBLIC_URL/download).
# MIN_LAUNCHER_VERSION=
# CLIENT_DOWNLOAD_URL=
# Cloud saves and media: off unless a folder (STORAGE_DIR) or an S3-compatible bucket (all four S3_
# settings; S3_REGION defaults to "auto") is given. STORAGE_QUOTA_MB per account (100), SAVE_MAX_MB
# per save (50). FILE_LINK_SECRET signs file links (default: derived from JWT_PRIVATE_KEY).
# STORAGE_DIR=./.files
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
