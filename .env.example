# Copy to .env for local development. Production values live in the server's environment.
DATABASE_URL=postgres://anytogether:anytogether@127.0.0.1:54329/anytogether
VALKEY_URL=redis://127.0.0.1:63799
# Ed25519 private key (PKCS#8 PEM) for access tokens; generated per run when empty (development).
JWT_PRIVATE_KEY=
PUBLIC_URL=http://localhost:3000
# Sign-in providers (empty disables one).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Mail for sign-in codes: "log" prints them (development), or "resend" with RESEND_API_KEY.
MAIL_TRANSPORT=log
RESEND_API_KEY=
MAIL_FROM=AnyTogether <signin@kodla.agency>
TURN_SECRET=
