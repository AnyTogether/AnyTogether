# cp .env.example .env, then fill in at least DOMAIN, ACME_EMAIL and POSTGRES_PASSWORD.
# docs/self-hosting.md explains every setting.

# The host name everything is served on (website /, API /api, gateway /rt). Its DNS A/AAAA record
# must point at this machine before the first start, so Caddy can get a certificate. "localhost"
# works for a first try on your own computer (Caddy's own certificate; the browser warns once).
DOMAIN=together.example.org
# Where Let's Encrypt writes about the certificate (expiry problems, mostly).
ACME_EMAIL=you@example.org

# The database password. Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Ed25519 private key (PKCS#8 PEM) that signs access tokens. Empty: a new one each start, which
# signs everyone out whenever the API restarts. docs/self-hosting.md ("The signing key") makes one
# as a single line; paste it between single quotes: JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n…'
JWT_PRIVATE_KEY=

# Sign-in mail (the 6-digit codes). "log" writes the codes to the API's log instead of sending
# them: docker compose logs api | grep code. For real mail use "smtp" with SMTP_URL
# (smtps://user:password@mail.example.org:465, or smtp://…:587 for STARTTLS) or "resend" with
# RESEND_API_KEY.
MAIL_TRANSPORT=log
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM=AnyTogether <signin@together.example.org>

# Optional ways in besides email codes and passkeys; empty turns one off.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Discord also links accounts to profiles. Register both redirect URIs in the Discord application:
# https://<DOMAIN>/auth/discord/callback and https://<DOMAIN>/connections/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: a Steam Web API key for linked Steam accounts' persona names (linking needs no key).
STEAM_WEB_API_KEY=

# The site's name in passkey prompts (passkeys belong to DOMAIN). Default: AnyTogether.
WEBAUTHN_RP_NAME=

# Calls. With the TURN relay (docker compose --profile turn up -d): a long random secret shared
# by coturn and the API (openssl rand -hex 32), and the URLs handed to clients, e.g.
# stun:together.example.org:3478,turn:together.example.org:3478?transport=udp,turn:together.example.org:3478?transport=tcp
# Empty: calls get no ICE servers from us and only connect where the networks allow it directly.
TURN_SECRET=
TURN_URLS=

# Hosts a game's icon may be loaded from (subdomains count), comma separated. Every launcher that
# shows the game loads its icon, so an icon elsewhere would tell that host who looks at it.
# Empty: icons sent by launchers are not kept.
GAME_ICON_HOSTS=

# Where rate limits read each visitor's address. "cf-connecting-ip" (default) trusts Cloudflare's
# header first: right behind Cloudflare, or with the Caddyfile here, which drops it. Behind another
# proxy that sets X-Real-IP but passes a visitor's own CF-Connecting-IP on, use "x-real-ip",
# or anyone could pick their own address and skip the sign-in limits.
CLIENT_IP_HEADER=cf-connecting-ip

# Browser push notifications (Web Push). A VAPID key pair made once and kept:
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
# and a contact for the push services, mailto:you@example.org. Empty: no push notifications (the
# notification list on the site still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: a GitHub token (no scopes needed) for the downloads page's release checks.
GITHUB_TOKEN=

# Cloud saves and media (photos, clips and voice notes in messages, the profile gallery). Off while
# both of these are empty. Either keep the files on this machine, in the "files" Docker volume:
#   STORAGE_DIR=/data/files
# or in an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO…), all four filled in:
#   S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com   S3_BUCKET=anytogether-files
#   S3_ACCESS_KEY=…   S3_SECRET_KEY=…   (S3_REGION: "auto" for R2, the bucket's region for AWS)
STORAGE_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Per account, saves and media together, and the biggest save archive (megabytes).
STORAGE_QUOTA_MB=100
SAVE_MAX_MB=50
# Signs the expiring links to files. Empty: made from JWT_PRIVATE_KEY (or new on every start
# without one, which ends the links handed out before).
FILE_LINK_SECRET=
