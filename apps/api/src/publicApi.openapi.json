    "/games/{titleId}/leaderboard": {
      "get": {
        "summary": "A game's global leaderboard",
        "description": "By trophy points, play time (seconds) or completion (percent). Only people who opened their library (and, for points and completion, their trophies) to everyone are on it. Kept for a minute.",
        "security": [
          {
            "token": ["leaderboards:read"]
          }
        ],
        "parameters": [
          {
            "name": "titleId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TitleId"
            }
          },
          {
            "name": "by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["points", "time", "completion"],
              "default": "points"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A game's global leaderboard",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests this token may make per minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in this minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the minute starts again.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Leaderboard"
                }
              }
            }
          },
          "400": {
            "description": "An unknown `by`, a `limit` out of range, or a `scope` other than global.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that is not valid (revoked, or its account is no longer active).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token lacks the scope (`scope` names it), or the part asked for is private (`section`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such game.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Over a rate limit. `Retry-After` says how many seconds to wait; `limit` names which one.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": ["Leaderboards"]
      }
    },
