    "/challenges": {
      "get": {
        "summary": "Challenges made for everyone",
        "description": "Running and coming ones by default, soonest first; `state=ended` lists those over, latest first. At most 50.",
        "security": [
          {
            "token": ["challenges:read"]
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["upcoming", "active", "ended"]
            }
          },
          {
            "name": "titleId",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TitleId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Challenges made for everyone",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests this token may make per minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in this minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the minute starts again.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenges": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Challenge"
                      }
                    }
                  },
                  "required": ["challenges"]
                }
              }
            }
          },
          "400": {
            "description": "An unknown state or a titleId that is not a title ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
