{
  "openapi": "3.1.0",
  "info": {
    "title": "AnyTogether public API",
    "version": "1.0.0",
    "summary": "Read-only access to what AnyTogether already shows everyone.",
    "description": "Public profiles and the parts their owners opened to everyone, the global leaderboards, and challenges made for everyone. Every request needs a personal API token, made in the account settings on anytogether.net. A token reads as a stranger would: being friends with someone never shows more. People blocked either way with the token's owner are left out. Answers carry handles, never account IDs. There are no write endpoints in this version.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://anytogether.net/api/v1/public"
    }
  ],
  "tags": [
    {
      "name": "Token",
      "description": "The token itself."
    },
    {
      "name": "Profiles",
      "description": "Scope `profiles:read`."
    },
    {
      "name": "Leaderboards",
      "description": "Scope `leaderboards:read`."
    },
    {
      "name": "Challenges",
      "description": "Scope `challenges:read`."
    }
  ],
  "security": [
    {
      "token": []
    }
  ],
  "paths": {
    "/token": {
      "get": {
        "summary": "The token in use",
        "description": "Its name, scopes and when it was made. Needs no scope.",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "The token in use",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests this token may make per minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in this minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the minute starts again.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that is not valid (revoked, or its account is no longer active).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token lacks the scope (`scope` names it), or the part asked for is private (`section`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Over a rate limit. `Retry-After` says how many seconds to wait; `limit` names which one.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": ["Token"]
      }
    },
    "/users/{handle}": {
      "get": {
        "summary": "A profile card",
        "description": "The card a signed-out reader sees. With the person's public profile switch off it is the minimal card: name and picture, nothing else.",
        "security": [
          {
            "token": ["profiles:read"]
          }
        ],
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The person's handle, without the @."
          }
        ],
        "responses": {
          "200": {
            "description": "A profile card",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests this token may make per minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in this minute.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the minute starts again.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileCard"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that is not valid (revoked, or its account is no longer active).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token lacks the scope (`scope` names it), or the part asked for is private (`section`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No one with that handle, or a block either way.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Over a rate limit. `Retry-After` says how many seconds to wait; `limit` names which one.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": ["Profiles"]
      }
    },
