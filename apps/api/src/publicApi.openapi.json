                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": ["Challenges"]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal API token (it starts with `atp_`). Each token may make 60 requests a minute and 10,000 a day, and all tokens of one account 120 a minute together."
      }
    },
    "schemas": {
      "TitleId": {
        "type": "string",
        "pattern": "^[A-Z]{4}[0-9]{5}$",
        "examples": ["PPSA01234"]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "examples": ["unauthorized", "forbidden", "not_found", "rate_limited"]
          },
          "scope": {
            "type": "string",
            "description": "The scope a token lacks."
          },
          "section": {
            "type": "string",
            "description": "The private part: profile, library or trophies."
          },
          "limit": {
            "type": "string",
            "description": "The rate limit reached."
          },
          "retryAfter": {
            "type": "integer"
          }
        },
        "required": ["status", "code"]
      },
      "Token": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["profiles:read", "leaderboards:read", "challenges:read"]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["name", "scopes", "createdAt"]
      },
      "Person": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatar": {
            "type": ["string", "null"],
            "format": "uri"
          }
        },
        "required": ["handle", "displayName", "avatar"]
      },
      "ProfileCard": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatar": {
            "type": ["string", "null"]
          },
          "bio": {
            "type": ["string", "null"]
          },
          "country": {
            "type": ["string", "null"]
          },
          "publicProfile": {
            "type": "boolean"
          },
          "visible": {
            "type": "object",
            "properties": {
              "library": {
                "type": "boolean"
              },
              "trophies": {
                "type": "boolean"
              },
              "friends": {
                "type": "boolean"
              },
              "presence": {
                "type": "boolean"
              }
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "trophyCounts": {
            "type": "object",
            "additionalProperties": true
          },
          "trophyLevel": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "cover": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "accent": {
            "type": ["string", "null"]
          }
        },
        "required": ["handle", "displayName", "avatar", "publicProfile", "visible"]
      },
      "Library": {
        "type": "object",
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "titleId": {
                  "$ref": "#/components/schemas/TitleId"
                },
                "names": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "iconUrl": {
                  "type": ["string", "null"]
                },
                "firstPlayedAt": {
                  "type": ["string", "null"],
                  "format": "date-time"
                },
                "lastPlayedAt": {
                  "type": ["string", "null"],
                  "format": "date-time"
                },
                "secondsPlayed": {
                  "type": "integer"
                },
                "trophiesEarned": {
                  "type": ["integer", "null"]
                },
                "trophiesTotal": {
                  "type": ["integer", "null"]
                },
                "progress": {
                  "type": ["integer", "null"]
                },
                "points": {
                  "type": ["integer", "null"]
                }
              }
            }
          }
        },
        "required": ["games"]
      },
      "Game": {
        "type": "object",
        "properties": {
          "titleId": {
            "$ref": "#/components/schemas/TitleId"
          },
          "names": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "By language code."
          },
          "iconUrl": {
            "type": ["string", "null"]
          }
        },
        "required": ["titleId", "names", "iconUrl"]
      },
      "Leaderboard": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "enum": ["points", "time", "completion"]
          },
          "game": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Game"
              },
              {
                "type": "null"
              }
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": {
                  "type": "integer",
                  "description": "Shared by equal values (1, 2, 2, 4)."
                },
                "user": {
                  "$ref": "#/components/schemas/Person"
                },
                "value": {
                  "type": "integer",
                  "description": "Points, seconds played or completion percent."
                },
                "level": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": ["rank", "user", "value"]
            }
          },
          "total": {
            "type": "integer",
            "description": "How many people are on the board."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["board", "game", "entries", "total", "updatedAt"]
      },
      "Standing": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for someone who keeps that part of their profile private."
          },
          "value": {
            "type": "integer"
          }
        },
        "required": ["rank", "user", "value"]
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "game": {
            "$ref": "#/components/schemas/Game"
          },
          "metric": {
            "type": "string",
            "enum": ["points", "trophies", "time"],
            "description": "Trophy points, trophies or seconds played between startsAt and endsAt."
          },
          "audience": {
            "type": "string",
            "enum": ["public"]
          },
          "community": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "creator": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string",
            "enum": ["upcoming", "active", "ended"]
          },
          "final": {
            "type": "boolean",
            "description": "Over, and the standings will not change (an hour after the end)."
          },
          "entrants": {
            "type": "integer"
          },
          "leader": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Standing"
              },
              {
                "type": "null"
              }
            ],
            "description": "First place, or the winner once it ended."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "game",
          "metric",
          "startsAt",
          "endsAt",
          "state",
          "final",
          "entrants",
          "leader"
        ]
      },
      "ChallengeDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Challenge"
          },
          {
            "type": "object",
            "properties": {
              "standings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Standing"
                }
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["standings", "updatedAt"]
          }
        ]
      }
    }
  }
}
