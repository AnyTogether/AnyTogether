            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token lacks the scope (`scope` names it), or the part asked for is private (`section`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Over a rate limit. `Retry-After` says how many seconds to wait; `limit` names which one.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": ["Challenges"]
      }
    },
    "/challenges/{id}": {
      "get": {
        "summary": "A challenge and its standings",
        "description": "The first 100 places. Someone who keeps that part of their profile from everyone (the library for play time, trophies otherwise) keeps their place with `user` null.",
