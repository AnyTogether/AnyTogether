# One image per Node app: docker build -f infra/Dockerfile.node --build-arg APP=api .
# The app and its packages are bundled into one file; the image holds only that and the migrations.
FROM node:22-alpine AS build
ARG APP
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @anytogether/${APP} build

FROM node:22-alpine
ARG APP
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/${APP}/dist ./dist
COPY --from=build /repo/packages/db/drizzle ./drizzle
USER node
CMD ["node", "dist/main.js"]
